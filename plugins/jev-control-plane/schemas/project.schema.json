{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev.dev/schemas/project.schema.json",
  "title": "Jev project manifest",
  "type": "object",
  "required": ["client", "project", "blueprint", "services", "environments", "policy"],
  "properties": {
    "client": {
      "type": "object",
      "required": ["client_id", "display_name"],
      "properties": {
        "client_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "required": ["project_id", "project_type"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "project_type": {"type": "string", "minLength": 1}
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["phase", "business_goal", "scope", "definition_of_done"],
      "properties": {
        "phase": {"type": "string"},
        "business_goal": {"type": "string"},
        "primary_users": {"type": "array", "items": {"type": "string"}},
        "scope": {
          "type": "object",
          "required": ["required", "excluded"],
          "properties": {
            "required": {"type": "array", "items": {"type": "string"}},
            "excluded": {"type": "array", "items": {"type": "string"}}
          }
        },
        "definition_of_done": {"type": "array", "items": {"type": "string"}}
      }
    },
    "services": {"type": "object"},
    "environments": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {"type": "string"},
        "production": {"type": "string"}
      }
    },
    "policy": {
      "type": "object",
      "required": ["production_requires_confirmation", "destructive_actions"],
      "properties": {
        "production_requires_confirmation": {"type": "boolean"},
        "destructive_actions": {"type": "string"}
      }
    }
  }
}
